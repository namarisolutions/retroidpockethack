# 24/7 CSK network monitor as a *user* service (no root, survives logout).
# Install:
#   mkdir -p ~/.config/systemd/user
#   sed "s|__DIR__|$HOME/csk|g" ~/csk/systemd/csk-monitor.service > ~/.config/systemd/user/csk-monitor.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now csk-monitor
#   loginctl enable-linger $USER     # keep it running when you're not logged in
#   journalctl --user -u csk-monitor -f
[Unit]
Description=CSK counter-surveillance network monitor
After=network-online.target

[Service]
# --no-rf if you run it without the ESP32 plugged in.
ExecStart=__DIR__/run.sh --monitor
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
